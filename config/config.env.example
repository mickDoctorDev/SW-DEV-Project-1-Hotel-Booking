# Copy to config/config.env and fill in. config.env is git-ignored — never commit real values.
NODE_ENV=development
# 5001 matches the frontend's API_URL (vacqfrontend/src/features/auth/authService.js)
PORT=5001
# MongoDB Atlas connection string (Atlas is a replica set, which booking transactions need)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-booking?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
# Access token lifetime; keep in line with the 15-minute access cookie
JWT_EXPIRE=15m
JWT_REFRESH_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# true = skip the auth and global rate limiters while rehearsing the Newman demo (ignored in production).
# The 5-per-minute booking limiter always stays on.
RELAX_RATE_LIMITS=true

# Set only if you get "querySrv ECONNREFUSED": DNS servers Node uses to resolve the mongodb+srv address
DNS_SERVERS=8.8.8.8,1.1.1.1
