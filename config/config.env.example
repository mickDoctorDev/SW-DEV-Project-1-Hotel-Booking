# Copy to config/config.env and fill in. config.env is git-ignored — never commit real values.
NODE_ENV=development
# 5001 matches the frontend's API_URL (vacqfrontend/src/features/auth/authService.js)
PORT=5001
# MongoDB Atlas connection string (Atlas is a replica set, which booking transactions need)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-booking?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
# Access token lifetime; keep in line with the 15-minute access cookie
JWT_EXPIRE=15m
JWT_REFRESH_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Secret that signs the check-in QR codes (HMAC-SHA256). Use a long random string, different from JWT_SECRET.
CHECKIN_TOKEN_SECRET=<another-long-random-string>

# Set only if you get "querySrv ECONNREFUSED": DNS servers Node uses to resolve the mongodb+srv address
DNS_SERVERS=8.8.8.8,1.1.1.1

# Confirmation emails. Leave SMTP_HOST empty to use a free Ethereal test inbox (the API returns a preview URL).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hotel Booking <no-reply@hotel-booking.local>

# Test accounts created by "npm run seed" (dev only; skipped when NODE_ENV=production).
# Pick your own passwords; the Newman demo reads them from here.
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_USER_EMAIL=user@test.com
SEED_USER_PASSWORD=<choose-a-password>

# AI support chatbot (Additional Req 3). Get a Gemini key at https://aistudio.google.com/apikey
CHAT_PROVIDER=gemini
CHAT_API_KEY=<your-gemini-api-key>
CHAT_MODEL=gemini-3.5-flash-lite
